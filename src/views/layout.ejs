<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'Patient Triage' %> · Patient Intake Triage</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col">
  <header class="bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <span class="grid place-items-center w-8 h-8 rounded-lg bg-teal-500 text-slate-900 text-sm">PT</span>
        <span>Patient Intake Triage</span>
      </a>
      <nav class="flex items-center gap-1 text-sm">
        <% const nav = typeof activeNav !== 'undefined' ? activeNav : ''; %>
        <% if (user) { %>
          <a href="/" class="px-3 py-1.5 rounded-md <%= nav === 'dashboard' ? 'bg-white/10' : 'hover:bg-white/10' %>">Dashboard</a>
          <a href="/intake/new" class="px-3 py-1.5 rounded-md <%= nav === 'intake' ? 'bg-white/10' : 'hover:bg-white/10' %>">New intake</a>
          <span class="px-3 text-slate-400"><%= user.display_name || user.username %></span>
          <form method="post" action="/logout" class="inline">
            <button type="submit" class="px-3 py-1.5 rounded-md hover:bg-white/10 text-slate-200">Log out</button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <%- body %>
  </main>

  <footer class="border-t border-slate-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 py-4 text-xs text-slate-500 flex flex-col sm:flex-row gap-1 justify-between">
      <span>Triage guideline engine · deterministic rule-based assessment</span>
      <span>Not a substitute for professional clinical judgment. When in doubt, escalate.</span>
    </div>
  </footer>
</body>
</html>